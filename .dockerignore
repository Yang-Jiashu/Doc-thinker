# Deny by default. A build context must never contain personal runtime state.
**
!.dockerignore
!deploy/
!deploy/invite/
!deploy/invite/Dockerfile
!deploy/invite/requirements.txt
!docthinker/
!docthinker/**/
!docthinker/**/*.py
!docthinker/*.py
!docthinker/knowledge_base_schema.sql
!docthinker/knowledge_skills/*/knowledge.json
!docthinker/knowledge_skills/*/SKILL.md
!graphcore/
!graphcore/**/
!graphcore/**/*.py
!graphcore/*.py
!clients/
!clients/mobile/
!clients/mobile/package.json
!clients/mobile/package-lock.json
!clients/mobile/index.html
!clients/mobile/vite.config.js
!clients/mobile/src/
!clients/mobile/src/**
!clients/mobile/public/
!clients/mobile/public/**
!clients/mobile/scripts/
!clients/mobile/scripts/**
# Defense in depth for the explicitly allowed trees.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.sqlite*
**/*.db*
**/node_modules/**
**/__pycache__/**
**/.DS_Store
docthinker/ui/**
graphcore/coregraph/api/**
graphcore/coregraph/tools/**
