include requirements.txt
include README.md
include README.zh-CN.md
include LICENSE
include env.example
recursive-include docthinker *.py
recursive-include docthinker/ui/templates *.html
recursive-include docthinker/ui/static *.css *.js *.png *.jpg *.svg *.woff2
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.egg-info
